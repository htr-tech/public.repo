{
    "workbench.iconTheme": "vscode-modern-icons",
    "workbench.colorTheme": "Dark 2026",

    "editor.fontFamily": "'Monaspace Krypton NF', 'ComicShannsMono Nerd Font', 'Monaspace Argon NF', 'RecMonoCasual Nerd Font', 'JetBrainsMono Nerd Font'",

    "editor.fontSize": 16,
    "editor.fontLigatures": true,
    "editor.wordWrap": "on",
    "editor.wordWrapColumn": 120,
    "editor.cursorStyle": "line",
    "editor.cursorBlinking": "phase",
    "editor.smoothScrolling": true,
    "editor.mouseWheelZoom": true,
    "editor.formatOnPaste": false,
    "editor.formatOnSave": false,
    // "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.detectIndentation": true,
    "editor.linkedEditing": true,
    "editor.autoClosingQuotes": "always",
    "editor.inlineSuggest.enabled": true,
    "editor.suggestSelection": "first",
    "editor.quickSuggestions": {
        "comments": "on",
        "strings": "on",
        "other": "on"
    },

    "files.autoSave": "afterDelay",
    // "files.trimTrailingWhitespace": true,
    "explorer.confirmDelete": false,
    "workbench.startupEditor": "none",
    "workbench.editor.enablePreview": false,
    "workbench.tips.enabled": false,
    "workbench.experimental.modernUI": true,

    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
    "terminal.integrated.lineHeight": 1.28,
    "terminal.integrated.fontSize": 15,
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.mouseWheelZoom": true,
    "terminal.integrated.defaultProfile.windows": "PowerShell",

    "security.workspace.trust.enabled": false,
    "security.workspace.trust.untrustedFiles": "open",
    
    "update.mode": "none",
    "update.enableWindowsBackgroundUpdates": false,
    "telemetry.telemetryLevel": "off",
    "telemetry.feedback.enabled": false,
    "terminal.integrated.gpuAcceleration": "off",

    // AI Features
    "chat.disableAIFeatures": true,
    "chat.agent.enabled": false,
    "terminal.integrated.initialHint": false,

    "notebook.lineNumbers": "on",
    "notebook.compactView": false,
    "notebook.showFoldingControls": "always",
    "notebook.cellToolbarVisibility": "hover",
    "notebook.consolidatedRunButton": true,

    "background.windowBackgrounds": [
        "c:/Users/Catz/Pictures/Wallpaper/002.jpg"
    ],

    "code-runner.enableAppInsights": false,
    "code-runner.clearPreviousOutput": true,
    "code-runner.fileDirectoryAsCwd": false,
    "code-runner.ignoreSelection": true,
    "code-runner.runInTerminal": true,
    "code-runner.showRunCommandInExplorerContextMenu": false,
    
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "path": "C:\\Users\\Catz\\AppData\\Local\\Microsoft\\WindowsApps\\Microsoft.PowerShell_8wekyb3d8bbwe\\pwsh.exe"
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        },
        "Git Bash": {
            "source": "Git Bash",
            "icon": "terminal-git-bash",
            "path": "C:\\Program Files\\Git\\bin\\bash.exe",
            "args": [
                "--login",
                "-i"
            ]
        }
    },
    
}